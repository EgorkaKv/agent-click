{
  "name": "agent-click",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that lets Claude Code drive the user's real browser like a human",
  "bin": {
    "agent-click": "dist/server.js"
  },
  "scripts": {
    "build:page": "node scripts/build-page.mjs",
    "build": "npm run build:page && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build:page && vitest run",
    "start": "node dist/server.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dom-accessibility-api": "^0.7.1",
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
